# Copy with `make env`, which also fills every CHANGE_ME with a random secret.
# Never commit .env.

# Owner of the simulated EHR database
EHR_DB_PASSWORD=CHANGE_ME
# Debezium's read-only replication login
CDC_PASSWORD=CHANGE_ME
# Key for pseudonyms and date shifts (Day 8). Losing it breaks token joins; leaking it
# lets someone re-identify tokens from known identifiers. Treat it like a database password.
DEID_SECRET=CHANGE_ME

# Analytics zone: database owner (the processor) and the read-only analyst login
ANALYTICS_DB_PASSWORD=CHANGE_ME
ANALYST_PASSWORD=CHANGE_ME

# Simulator: days of history to backfill on first start, seconds between live steps
SIM_BACKFILL_DAYS=90
SIM_LIVE_SECONDS=10
